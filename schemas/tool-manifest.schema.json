{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nedal7707/worktree-proof/schemas/tool-manifest.schema.json",
  "title": "WorktreeProof tool manifest",
  "description": "A declarative, probe-only description of a developer tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "categories",
    "capabilities",
    "command",
    "probes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,63})$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?!\\s)(?:[^\\u0000-\\u001F\\u007F]*\\S)$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!\\s)(?:[^\\u0000-\\u001F\\u007F]*\\S)$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "command": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,63}$"
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "source": {
      "type": "string",
      "enum": ["builtin", "custom"]
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9+._/-]{0,63}$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "--version",
              "-V",
              "-v",
              "version",
              "-version",
              "/version",
              "--help",
              "-h",
              "help",
              "/?"
            ]
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 2000
        }
      }
    }
  }
}
