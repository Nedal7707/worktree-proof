{
  "$schema": "../schemas/tool-manifest.schema.json",
  "id": "worktree-proof-tool",
  "name": "Portable WorktreeProof tool",
  "description": "A declarative local capability surface for inspecting, editing, testing, previewing, and recording bounded work.",
  "categories": ["workflow", "verification"],
  "capabilities": [
    "inspect",
    "edit",
    "test",
    "preview",
    "browser",
    "deploy",
    "external-write",
    "destructive",
    "secrets-sensitive",
    "build",
    "api",
    "database",
    "mobile",
    "docs",
    "security",
    "performance",
    "accessibility",
    "ci",
    "dependency",
    "incident",
    "worktree",
    "evidence",
    "receipt",
    "release"
  ],
  "tags": ["portable", "read-only-first", "redacted-evidence"],
  "command": "worktree-proof",
  "probes": [{ "args": ["--version"] }]
}
