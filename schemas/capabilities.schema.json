{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nedal7707/worktree-proof/schemas/capabilities.schema.json",
  "title": "WorktreeProof capabilities",
  "description": "Bounded declarative capability negotiation data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocolVersion", "schemaVersion", "capabilities", "limits"],
  "properties": {
    "protocol": { "const": "worktreeproof" },
    "protocolVersion": { "const": "1.0" },
    "schemaVersion": { "const": "1" },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[./_-][a-z0-9]+)*$",
        "maxLength": 128
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMessageBytes", "maxBatchItems"],
      "properties": {
        "maxMessageBytes": { "const": 16384 },
        "maxBatchItems": { "const": 128 }
      }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "mutating"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[./_-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
          "maxLength": 32
        },
        "mutating": { "type": "boolean" }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Explicit vendor/client extension point; values remain bounded by the enclosing message limit.",
      "maxProperties": 100,
      "additionalProperties": true
    }
  }
}
