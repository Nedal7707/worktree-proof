{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nedal7707/worktree-proof/schemas/lane.schema.json",
  "title": "WorktreeProof lane",
  "description": "A portable description of one independently managed work lane.",
  "type": "object",
  "additionalProperties": false,
  "required": ["laneId", "fileScope"],
  "properties": {
    "laneId": {
      "type": "string",
      "description": "Stable, normalized identifier unique within a run.",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "fileScope": {
      "type": "string",
      "description": "Relative, non-overlapping scope owned by this lane.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])[^\\u0000]*$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mode": {
      "type": "string",
      "enum": ["build", "integrate", "cleanup", "audit", "run"]
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "integrationTarget": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "canonicalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "string",
      "enum": ["planned", "reserved", "running", "released", "closed", "abandoned"]
    },
    "leaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Non-secret caller metadata.",
      "additionalProperties": true
    }
  }
}
