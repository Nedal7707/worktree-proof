{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nedal7707/worktree-proof/schemas/closure-receipt.schema.json",
  "title": "WorktreeProof closure receipt",
  "description": "Portable evidence that a lane reached a terminal state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["laneId", "closedAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "laneId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": ["merged", "abandoned"]
    },
    "status": {
      "type": "string",
      "enum": ["merged", "abandoned"]
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "mergeSha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "branchDeleted": {
      "type": "boolean"
    },
    "worktreeClean": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tests": {
      "description": "JSON-safe test evidence; its shape is intentionally caller-defined.",
      "$ref": "#/$defs/jsonValue"
    },
    "deploy": {
      "$ref": "#/$defs/jsonValue"
    },
    "evidence": {
      "$ref": "#/$defs/jsonValue"
    },
    "checks": {
      "$ref": "#/$defs/jsonValue"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["outcome"],
          "properties": {
            "outcome": { "const": "merged" },
            "canonicalRef": { "type": "string" },
            "mergeSha": { "type": "string" },
            "tests": {}
          }
        },
        {
          "required": ["outcome"],
          "properties": {
            "outcome": { "const": "abandoned" },
            "branchDeleted": { "const": true },
            "worktreeClean": { "const": true }
          }
        },
        {
          "required": ["status"],
          "properties": {
            "status": { "const": "merged" },
            "canonicalRef": { "type": "string" },
            "mergeSha": { "type": "string" },
            "tests": {}
          }
        },
        {
          "required": ["status"],
          "properties": {
            "status": { "const": "abandoned" },
            "branchDeleted": { "const": true },
            "worktreeClean": { "const": true }
          }
        }
      ]
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
