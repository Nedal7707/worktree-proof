{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nedal7707/worktree-proof/schemas/skill-source.schema.json",
  "title": "WorktreeProof optional skill source manifest",
  "description": "Metadata for upstream Agent Skills that WorktreeProof may reference without installing or executing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "sources"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/skill-source.schema.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "url",
        "license",
        "upstreamRef",
        "purpose",
        "provenance",
        "install",
        "policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "minLength": 3,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/?$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "upstreamRef": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authors", "licenseOwner"],
          "properties": {
            "kind": { "const": "upstream" },
            "authors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "licenseOwner": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["list", "selective"],
          "properties": {
            "list": {
              "type": "string",
              "pattern": "^npx skills add https://github\\.com/[^ ]+ --list$"
            },
            "selective": {
              "type": "string",
              "pattern": "^npx skills add https://github\\.com/[^ ]+ --skill <skill-name>$"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendored", "autoInstall", "authenticate", "execute"],
          "properties": {
            "vendored": { "const": false },
            "autoInstall": { "const": false },
            "authenticate": { "const": false },
            "execute": { "const": false }
          }
        }
      }
    }
  }
}

